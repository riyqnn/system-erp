{
  "name": "project-4b",
  "version": "1.0.0",
  "private": true,
  "description": "PT Mayora Enterprise System - Monorepo",
  "scripts": {
    "dev": "concurrently \"pnpm --filter web dev\" \"pnpm --filter api start:dev\"",
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api start:dev",
    "build": "pnpm --filter web build && pnpm --filter api build",
    "build:web": "pnpm --filter web build",
    "build:api": "pnpm --filter api build",
    "start": "concurrently \"pnpm --filter web start\" \"pnpm --filter api start\"",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules",
    "lint": "pnpm --filter web lint && pnpm --filter api lint"
  },
  "keywords": ["monorepo", "nextjs", "nestjs", "enterprise"],
  "author": "PT Mayora Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
